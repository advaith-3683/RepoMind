# ---------------- required ----------------
# Embeddings (Gemini). Embedding calls use a separate model quota from chat.
GEMINI_API_KEY=
# Supabase: click "Connect" -> "Session pooler" (IPv4-compatible, needed for Render). Host looks like
# aws-0-<region>.pooler.supabase.com, port 5432, user postgres.<project-ref>. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Answering LLM: any OpenAI-compatible API. Groq is the default (console.groq.com -> API Keys).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b          # verify against the provider's current model list
LLM_JSON_MODE=true                     # set false if a model rejects response_format=json_object
LLM_MAX_OUTPUT_TOKENS=2000
LLM_REASONING_EFFORT=low               # low|medium|high; only sent to gpt-oss models (reasoning tokens share the output budget)

# ---------------- optional fallback (used on rate limits / 5xx) ----------------
# OpenRouter: free ":free" models are capped (50/day until you've bought $10 of credits, then 1000/day).
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=                    # pick a ":free" model id from openrouter.ai/models; needs BOTH key and model

# ---------------- saving API calls ----------------
LLM_CACHE=readwrite                    # off | readwrite | replay (replay never calls the API; misses raise)
CACHE_DIR=./data/cache
DEFAULT_ASK_MODE=fast                  # fast = retrieve once + 1 LLM call; agent = full tool loop
FAST_TOP_K=5
SEARCH_PREVIEW_LINES=60
FAST_MAX_STEPS=3

# ---------------- models / embeddings ----------------
EMBED_DIM=768                          # must match vector(768) in backend/sql/schema.sql
GEMINI_EMBED_MODEL=gemini-embedding-001   # verify against current Gemini docs
# Only used if LLM_PROVIDER=gemini (then Gemini also answers):
LLM_PROVIDER=openai_compat
GEMINI_CHAT_MODEL=gemini-2.5-flash

# ---------------- storage / limits ----------------
REPOS_DIR=./data/repos
MAX_REPO_MB=50
MAX_FILE_KB=200
MAX_CHUNKS_PER_REPO=4000

# ---------------- agent guardrail budgets ----------------
MAX_AGENT_STEPS=8
MAX_TOKENS_PER_QUERY=60000
QUERY_TIMEOUT_S=90
MAX_QUERY_CHARS=1000
RATE_LIMIT_PER_MIN=20

# ---------------- retrieval ----------------
RETRIEVAL_TOP_K=5
RETRIEVAL_POOL=30

# ---------------- cost tracking: USD per 1M tokens (0 = untracked) ----------------
PRICE_IN_PER_MTOK=0
PRICE_OUT_PER_MTOK=0

# ---------------- auth (Supabase Auth, "Sign in with GitHub") ----------------
# AUTH_REQUIRED=false is for LOCAL DEV ONLY: every request runs as one shared anonymous user.
AUTH_REQUIRED=true
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=            # the public "anon"/publishable key (safe to expose; never the service_role key)
MAX_NEW_REPOS_PER_USER_PER_DAY=5
GITHUB_API_URL=https://api.github.com
GITHUB_API_TOKEN=             # optional, server-side, read-only: lifts the 60/h anonymous GitHub REST limit on shared hosts

CORS_ORIGINS=*
